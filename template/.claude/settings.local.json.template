      "Bash(curl -s -u {{REVIEWER_USERNAME}}:* -H cf-access-token:* -X POST -H Content-Type:* --data @/tmp/* {{FORGEJO_BASE_URL}}/api/v1/repos/{{REPO}}/issues/*/comments)",

